{
  "all": true,
  "src": ["lib", "src", "cli"],
  "include": ["lib/**/*.js", "src/**/*.js", "cli/**/*.mjs"],
  "exclude": ["tests/**", "tools/**", "build/**", "coverage/**", "node_modules/**"],
  "reporter": ["text-summary", "lcov"],
  "reports-dir": "build/coverage",
  "check-coverage": true,
  "lines": 90,
  "branches": 90,
  "functions": 90,
  "statements": 90
}
