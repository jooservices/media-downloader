  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "detail"],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "additionalProperties": false
      },
      "Config": {
        "type": "object",
        "required": ["workers", "delaySeconds", "maxAttempts", "limit", "downloadDir", "notify"],
        "properties": {
          "workers": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "delaySeconds": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              },
              "max": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              }
            },
            "additionalProperties": false
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "limit": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "downloadDir": {
            "type": ["string", "null"]
          },
          "notify": {
            "type": ["object", "null"]
          }
        },
        "additionalProperties": false
      },
      "Status": {
        "type": "object",
        "required": ["uptimeSeconds"],
        "properties": {
          "uptimeSeconds": {
            "type": "number"
          },
          "jobs": {
            "type": "object"
          },
          "extension": {
            "type": "object"
          },
          "pid": {
            "type": "integer"
          }
        }
      },
      "Counts": {
        "type": "object",
        "required": ["started", "pending", "failed", "skipped"],
        "properties": {
          "started": {
            "type": "integer"
          },
          "pending": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "status",
          "platform",
          "account",
          "url",
          "message",
          "counts",
          "createdAt",
          "updatedAt",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "running", "complete", "incomplete", "paused", "error"]
          },
          "platform": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "message": {
            "type": "string"
          },
          "counts": {
