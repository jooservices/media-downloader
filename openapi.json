  "info": {
    "title": "Page Media Saver API",
    "version": "1.0.0",
    "description": "Local queue API. Every operation except health requires a bearer token. HEAD and OPTIONS are protocol-level HTTP conveniences and do not represent additional queue actions; MCP exposes each application action as a tool."
  },
